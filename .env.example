# AI 图像生成网站配置
# 复制此文件为 .env 并填写实际值

# AI 图像生成 API
IMAGE_GEN_API_URL=https://api.your-image-gen.com/v1
IMAGE_GEN_API_KEY=your-api-key-here

# 图床配置
IMAGE_HOSTING_UPLOAD_URL=https://img.heliar.top/upload
IMAGE_HOSTING_BASE_URL=https://img.heliar.top
IMAGE_HOSTING_REFERER=https://img.heliar.top/

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 文件限制
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp

# 管理员账号（首次运行时自动创建）
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_password_here

# 安全
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=127.0.0.1,::1,private
FORWARDED_ALLOW_IPS=127.0.0.1,::1
ENABLE_HSTS=false
MAX_REMOTE_IMAGE_BYTES=20971520
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 频率限制 (每分钟请求数)
RATE_LIMIT_PER_MINUTE=60

# PostgreSQL 数据库
DATABASE_URL=postgresql://app_user:password@localhost:5432/app_db
PG_USER=app_user
PG_PASSWORD=password
PG_DB=app_db
PG_POOL_MIN=5
PG_POOL_MAX=20

# Docker 部署端口
APP_PORT=5173

# GitHub 图床
GITHUB_HOSTING_ENABLED=false
GITHUB_HOSTING_REPO=your_username/your_repo
GITHUB_HOSTING_TOKEN=your_github_pat
GITHUB_HOSTING_BRANCH=main

# 邮件配置
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER=your_email@qq.com
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_SENDER=noreply@example.com
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# LLM 配置（AI 优化提示词）
LLM_BASE_URL=https://your-llm-api-endpoint
LLM_API_KEY=your_llm_api_key
LLM_MODEL=your_model_name
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=30

# 供应商 API Key（管理后台修改后自动更新，格式：PROVIDER_{名称}_API_KEY）
PROVIDER_WUYIN_MAIN_API_KEY=your_provider_api_key

# 联网搜索（SearXNG 自建实例，免费无限量）
# docker compose 部署时后端通过服务名访问，无需修改；
# 本地（非 docker）跑后端时改为 SEARXNG_URL=http://127.0.0.1:8081
# SEARXNG_URL=http://searxng:8080
# SEARXNG_PORT=8081
# 联网搜索限流与上游保护（可选，有默认值）
# SEARCH_RATE_PER_MINUTE=3        # 每用户每分钟最多搜索次数（防单个用户刷）
# SEARCH_MAX_PER_RUN=2            # 单次对话（agent 一轮）最多搜索次数
# SEARCH_CACHE_TTL=300            # 相同关键词结果缓存秒数（命中不消耗搜索次数）
# SEARCH_GLOBAL_RATE_PER_MINUTE=45   # 全局对上游总速率上限（核心防封：所有用户合计，低于 Bing 安全线 60/min）
# SEARCH_MAX_CONCURRENCY=3        # 同时最多几个真实上游请求（防突发堆积）
# SEARCH_BREAKER_THRESHOLD=5      # 上游连续失败多少次后打开熔断器
# SEARCH_BREAKER_OPEN_SECONDS=60  # 熔断器打开时长（期间快速失败，不再打上游）

# MinerU 云端文档解析（PDF/Office/图片等难解析文件，https://mineru.net）
# MINERU_API_KEY=sk-xxx    # MinerU 云 API token；不配置则只走本地解析，复杂文件解析会失败
# MINERU_MAX_FILE_BYTES=52428800   # 文件链接下载体积上限（默认 50MB）

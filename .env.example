# AI 图像生成网站配置
# 复制此文件为 .env 并填写实际值

# AI 图像生成 API
IMAGE_GEN_API_URL=https://api.your-image-gen.com/v1
IMAGE_GEN_API_KEY=your-api-key-here

# 图床配置
IMAGE_HOSTING_UPLOAD_URL=https://img.heliar.top/upload
IMAGE_HOSTING_BASE_URL=https://img.heliar.top
IMAGE_HOSTING_REFERER=https://img.heliar.top/

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 文件限制
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp

# 管理员账号（首次运行时自动创建）
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_password_here

# 安全
JWT_SECRET=
JWT_EXPIRE_HOURS=720
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 频率限制 (每分钟请求数)
RATE_LIMIT_PER_MINUTE=60
